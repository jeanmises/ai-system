# Database
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5432/ai_system

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# OIDC (Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/ai-system
OIDC_CLIENT_ID=ai-system-api
OIDC_AUDIENCE=ai-system-api
OIDC_JWKS_URL=http://localhost:8080/realms/ai-system/protocol/openid-connect/certs

# Application
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
